{
	"name": "draggable-list-items",
	"version": "0.2.10",
	"description": "Drag list items to reorder them.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:e2e": "./test/e2e/make-test-vault.sh && wdio run ./test/e2e/wdio.conf.mjs",
		"test:e2e:norec": "DLI_NO_REC=1 npm run test:e2e",
		"test:e2e:mobile": "DLI_MOBILE=1 npm run test:e2e",
		"test:e2e:all": "npm run test:e2e && npm run test:e2e:mobile",
		"test:e2e:novisual": "DLI_NO_VISUAL=1 npm run test:e2e",
		"e2e:vault": "./test/e2e/make-test-vault.sh"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"@wdio/cli": "^9.31.7",
		"@wdio/local-runner": "^9.31.7",
		"@wdio/mocha-framework": "^9.31.7",
		"@wdio/spec-reporter": "^9.31.2",
		"@wdio/visual-service": "^10.1.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"wdio-obsidian-service": "^3.2.0",
		"webdriverio": "^9.31.7"
	}
}
